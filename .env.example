# Todo es opcional: sin este archivo Buddy arranca igual con valores seguros para una prueba local.

# Puerto donde se abre Buddy (http://localhost:PUERTO)
BUDDY_PORT=8080

# En producción poné una contraseña propia para la base (la usa solo Buddy, no se publica afuera)
# BUDDY_DB_PASSWORD=cambiame-por-una-larga

# Si lo publicás detrás de HTTPS (recomendado), dejalo en 1. "auto" lo detecta por el proxy.
# BUDDY_COOKIE_SECURE=1

# Si el puerto queda expuesto antes de que configures Buddy, pedí un código para crear el primer administrador
# BUDDY_SETUP_TOKEN=un-codigo-largo

# IP de tu proxy inverso HTTPS (si tenés uno). Sin esto Buddy ignora la cabecera X-Forwarded-For.
# BUDDY_TRUSTED_PROXIES=172.18.0.1

# Tamaño máximo de cada archivo que se sube (MB)
# BUDDY_MAX_UPLOAD_MB=25
